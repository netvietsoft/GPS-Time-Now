<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release default: HTTPS-only, cleartext HTTP disabled (AUD-006 / PROD-08 / Google Play Device & Network Abuse Policy) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Production NextAI Domains: HTTPS strictly enforced -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">next.ai</domain>
        <domain includeSubdomains="true">nextai.technology</domain>
        <domain includeSubdomains="true">nextai.solution</domain>
        <domain includeSubdomains="true">nextai.global</domain>
    </domain-config>
</network-security-config>
