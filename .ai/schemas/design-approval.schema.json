{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextai.technology/schemas/v2.1.2/design-approval.schema.json",
  "title": "Design Gate Approval Record (Section 51 & 52)",
  "type": "object",
  "required": [
    "schema_version",
    "design_id",
    "revision",
    "decision",
    "approved_by",
    "approved_at",
    "frozen_artifacts"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2.1.2" },
    "design_id": { "type": "string" },
    "revision": { "type": "integer", "minimum": 1 },
    "decision": { "type": "string", "enum": ["APPROVED", "REJECTED", "REQUEST_CHANGES"] },
    "approved_by": { "type": "string" },
    "approved_at": { "type": "string" },
    "target_viewport": { "type": "string" },
    "frozen_artifacts": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
