{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextai.technology/schemas/v2.1.2/task.schema.json",
  "title": "Workspace Standard V2.1.2 Task Record",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "mode",
    "title",
    "owner",
    "status",
    "files_allowed",
    "acceptance_criteria"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2.1.2" },
    "id": { "type": "string", "pattern": "^(TASK|INCIDENT|AUDIT|REQUEST)-[A-Z0-9-]+$" },
    "feature_id": { "type": "string" },
    "phase": { "type": "string" },
    "mode": {
      "type": "string",
      "enum": [
        "READ_ONLY_AUDIT",
        "DIAGNOSTIC",
        "RESEARCH",
        "DESIGN",
        "IMPLEMENTATION",
        "REVIEW",
        "INCIDENT_HOTFIX"
      ]
    },
    "design_impact": {
      "type": "string",
      "enum": ["NONE", "LOW", "MEDIUM", "HIGH"]
    },
    "title": { "type": "string" },
    "owner": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["backlog", "ready", "running", "review", "blocked", "done"]
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files_allowed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files_forbidden": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "max_fix_cycles": { "type": "integer", "default": 5 },
    "related_error_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ERR-[0-9]{8}-[0-9]{3}$" }
    },
    "related_acquirement_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ACQ-[0-9]{8}-[0-9]{3}$" }
    }
  }
}
