# 5. Cloud Storage (AWS S3 / Cloudflare R2 STS Emulator)
STORAGE_PROVIDER=local_s3_emulator
S3_REGION=ap-southeast-1
S3_BUCKET_NAME=nextai-camera-media
S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
S3_ENDPOINT=http://localhost:4580/s3

# 6. AI / LLM & Vision Services
NEXTAI_LLM_PROVIDER=local_deterministic
