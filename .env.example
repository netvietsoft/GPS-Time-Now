# ============================================================================
# NextAI Camera & Enterprise Field SaaS Platform (.env.example)
# Package: com.nextai.camera | Workspace Standard V2.1.2
# Copy to Backend/.env for local execution. See Tasksrequiring.md for prod keys.
# ============================================================================

# 1. Server & Environment Configuration
NODE_ENV=development
PORT=4580
HOST=0.0.0.0
API_PREFIX=/next
PUBLIC_BASE_URL=http://localhost:4580
PRODUCTION_API_URL=https://api.nextai.technology/next/
PRODUCTION_ADX_URL=https://adx.nextai.technology/next/
PRODUCTION_TEAMSPACE_URL=https://teamspace.nextai.global

# 2. Database Configuration (OLTP 42-Table Mirror + OLAP Star Schema)
DB_DRIVER=sqlite
SQLITE_DB_PATH=./data/nextai_camera.db
# For cloud production scale-out:
# DB_DRIVER=postgres
# DATABASE_URL=postgresql://nextai:password@localhost:5432/nextai_camera

# 3. Authentication & Security
JWT_SECRET=demo-nextai-jwt-secret-replace-in-production-2026
JWT_EXPIRES_IN=7d
AEGIS_HMAC_SECRET=demo-nextai-aegis-hardware-signature-secret-2026
GOOGLE_WEB_CLIENT_ID=000000000000-nextaidemo.apps.googleusercontent.com
MSAL_CLIENT_ID=00000000-0000-0000-0000-nextaidemomsal
MSAL_REDIRECT_URI=msauth://com.nextai.camera/DemoSignatureHash%3D
FACEBOOK_APP_ID=000000000000000
FACEBOOK_CLIENT_TOKEN=demo_nextai_fb_client_token

# 4. Advertising (Google Official Test IDs by Default — Requirement #4)
ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713
ADMOB_APP_OPEN_UNIT_ID=ca-app-pub-3940256099942544/9257395921
ADMOB_INTERSTITIAL_UNIT_ID=ca-app-pub-3940256099942544/1033173712
ADMOB_NATIVE_UNIT_ID=ca-app-pub-3940256099942544/2247696110
